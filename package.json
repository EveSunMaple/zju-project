{
  "name": "openzju",
  "version": "1.0.0",
  "description": "A searchable static index of open source projects from Zhejiang University.",
  "license": "GPL-3.0-only",
  "keywords": [
    "zju",
    "zhejiang-university",
    "open-source",
    "directory",
    "astro",
    "heroui"
  ],
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm sync:projects && pnpm sync:audits && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "sync:projects": "tsx scripts/sync-projects.ts",
    "sync:audits": "tsx scripts/sync-audits.ts",
    "sync:audits:offline": "tsx scripts/sync-audits.ts --offline",
    "deep:prepare": "tsx scripts/deep-audit/prepare.ts",
    "deep:analyze": "tsx scripts/deep-audit/analyze.ts",
    "deep:merge": "tsx scripts/deep-audit/merge.ts",
    "sync:projects:offline": "tsx scripts/sync-projects.ts --offline",
    "check": "astro check && biome check .",
    "check:ci": "astro check && biome ci .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@heroui/styles": "3.2.7",
    "@iconify-json/lucide": "1.2.151",
    "@swup/a11y-plugin": "5.2.1",
    "@swup/head-plugin": "2.3.1",
    "@swup/preload-plugin": "3.2.12",
    "@swup/scroll-plugin": "4.0.0",
    "astro": "7.4.5",
    "astro-icon": "1.2.0",
    "swup": "4.10.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@biomejs/biome": "2.6.4",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "26.6.6",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
